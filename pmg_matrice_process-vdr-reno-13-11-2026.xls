  <style>
    body { font-family: Calibri, 'Segoe UI', Arial, sans-serif; font-size: 9.5pt; color: #1E293B; }
    table { border-collapse: collapse; width: 100%; table-layout: auto; }
    th { background-color: #002060; color: #FFFFFF; font-size: 9.5pt; font-weight: bold; text-align: center; border: 1px solid #001233; padding: 10px 8px; vertical-align: middle; white-space: normal; line-height: 1.3; }
    td { font-size: 9pt; border: 1px solid #D9D9D9; padding: 6px 8px; vertical-align: middle; mso-number-format:'\@'; }
    .cell-na { background-color: #F8FAFC !important; color: #94A3B8 !important; font-style: italic !important; text-align: center !important; font-weight: normal !important; }
    .cell-empty { color: #CBD5E1 !important; text-align: center !important; }
    .title-banner { background-color: #FFC000; color: #000000; font-size: 13pt; font-weight: 900; text-align: center; border: 2px solid #000000; padding: 14px 10px; }
    .slicer-card { background-color: #FFFFFF; border: 1px solid #CBD5E1; vertical-align: top; padding: 5px; font-size: 8pt; }
    .slicer-header { font-weight: bold; text-align: center; padding: 3px 4px; margin-bottom: 4px; border-bottom: 1px solid #E2E8F0; font-size: 8pt; border-radius: 2px; }
    .info-box { background-color: #548235; color: #FFFFFF; font-weight: bold; text-align: center; padding: 8px 6px; font-size: 9pt; border: 1px solid #000; }
  </style>
  </head>
  <body>
    <table>
      <!-- Row 1: Big Yellow Header Title Block (Modèle Bouygues PMG) -->
      <tr>
        <td colspan="5" class="title-banner">
          P1: Process VDR RENO
        </td>
        <td colspan="2" class="slicer-card">
          <div class="slicer-header" style="background:#E2EFDA; color:#385723;">Processus Métier Macro - Niveau N1</div>
          <div style="background:#548235; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Injecter les variables manquantes</div><div style="background:#548235; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Planifier les prerequis a la MEL-CDD</div><div style="background:#548235; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Récupérer les informations du projet-CDD</div><div style="background:#548235; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Vérifier l&#039;état du projet-CDD</div><div style="background:#548235; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Realiser les Prerequis MEL-CDD</div><div style="background:#548235; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Créer et valider l&#039;opération-CDD</div>
        </td>
        <td colspan="2" class="slicer-card">
          <div class="slicer-header" style="background:#FCE4D6; color:#C65911;">Sous-Processus Métier - Niveau N2</div>
          <div style="background:#ED7D31; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Injecter les variables manquantes</div><div style="background:#ED7D31; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">save migration variable value</div><div style="background:#ED7D31; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Vérifier et paramétrer instance</div><div style="background:#ED7D31; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Créer le GCR de SWAP</div><div style="background:#ED7D31; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">reset migration variable value</div><div style="background:#ED7D31; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">Réaliser la visite technique</div>
        </td>
        <td colspan="1" class="slicer-card">
          <div class="slicer-header" style="background:#D9E1F2; color:#1F4E78;">Entités</div>
          <div style="background:#2E75B6; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">CDD</div><div style="background:#2E75B6; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">OPS</div><div style="background:#2E75B6; color:#fff; padding:2px 6px; margin-bottom:2px; font-size:7.5pt; border-radius:3px; font-weight:600;">DCI</div>
        </td>
        <td colspan="2" class="info-box">
          PILOTAGE / AVANCEMENT :<br>
          <span style="font-size:8pt; font-weight:normal; opacity:0.95;">Direction Métier &bull; Camunda Web Modeler e787c33</span>
        </td>
        <td colspan="1" style="background:#FFC000; color:#000; font-weight:bold; font-size:8.5pt; text-align:center; border:1px solid #000; padding:6px;">
          CODE / BADGES :<br><strong>CDD / CPE / SGP / SP0</strong>
        </td>
      </tr>

      <!-- Empty separator line -->
      <tr style="height:6px;"><td colspan="13" style="border:none; height:6px;"></td></tr>

      <!-- Multi-Level PMG Table Header -->
      <thead>
        <tr x:autofilter="all">
          <th x:autofilter="all" style="width: 170px; background-color: #002060;">
