    <bpmn:callActivity id="Activity_1trbszl" name="Attribution des ressources fréq">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="DCI_Attribution_Ressource_Frequentielle" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=distinct values(listeCellule)" target="cellules" />
          <zeebe:input source="=&#34;VDR&#34;" target="processType" />
          <zeebe:input source="=migration_loop" target="migration_loop" />
          <zeebe:input source="=migration_max_wait_loop" target="migration_max_wait_loop" />
          <zeebe:input source="=how_migration_stop" target="how_migration_stop" />
          <zeebe:input source="=migrationActivities" target="migrationActivities" />
          <zeebe:input source="=migration" target="migration" />
          <zeebe:input source="=siteTheorique" target="siteTheorique" />
          <zeebe:input source="=region" target="region" />
          <zeebe:input source="=idUniqueMess" target="idUniqueMess" />
          <zeebe:input source="=outputFormulaireGcr" target="outputFormulaireGcr" />
          <zeebe:input source="=solutionDO" target="solutionDO" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:output source="=distinct values(&#10;  for f in listEquipement.bandfreq  return&#10;      if f=&#34;EGSM&#34; then &#34;2G&#34;&#10; else if f=&#34;UMTS900&#34; then &#34;3G900&#34;&#10; else if f=&#34;LTE700&#34;  then &#34;4G700&#34;&#10; else if f=&#34;LTE800&#34;  then &#34;4G800&#34;&#10; else if f=&#34;LTE1800&#34; then &#34;4G1800&#34;&#10; else if f=&#34;LTE2100&#34; then &#34;4G2100&#34;&#10; else if f=&#34;LTE2600&#34; then &#34;4G2600&#34;&#10; else if f=&#34;NR2100&#34; then &#34;5G2100&#34;&#10; else if f=&#34;NR3500&#34; then &#34;5G3500&#34;&#10; else f&#10;)" target="technos" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16okdj3</bpmn:incoming>
      <bpmn:outgoing>Flow_06uakhh</bpmn:outgoing>
    </bpmn:callActivity>
