    <bpmn:callActivity id="VDR_synchroniserLesEvolutionsDemandees" name="Synchroniser les évolutions demandées">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="itres-reso-besoin-evolutions" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=idBesoin" target="idBesoin" />
          <zeebe:input source="=groupeSUPPORT" target="groupeSUPPORT" />
          <zeebe:input source="=groupeSUPPORT_TECH" target="groupeSUPPORT_TECH" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:input source="=region" target="region" />
          <zeebe:output source="=for evolution in evolutions[etat = &#34;ETR&#34;] return {&#10;  type: evolution.type,&#10;  etat: evolution.etat,&#10;  libelleTechnologie2: evolution.libelleTechnologie2,&#10;  libelleTechnologie1: evolution.libelleTechnologie1,&#10;  libelleType: evolution.libelleType,&#10;  id: evolution.id,&#10;  operateur: evolution.operateur&#10;}" target="newEvolutions" />
          <zeebe:output source="=count(newEvolutions) &#62; count(evolutionsFiltred)" target="notifyEvolChangement" />
          <zeebe:output source="=if notifyEvolChangement&#10;then newEvolutions[some newEvol in evolutionsFiltred&#10;satisfies item.id!=newEvol.id] else []" target="deltaEvolutions" />
          <zeebe:output source="=newEvolutions" target="evolutionsFiltred" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0iikpdq</bpmn:incoming>
      <bpmn:outgoing>Flow_0q9mq2q</bpmn:outgoing>
    </bpmn:callActivity>
