  <bpmn:process id="VDR_RealiserTestTNT" name="VDR_RealiserTestTNT" isExecutable="true">
    <bpmn:startEvent id="Event_021vwnc" name="Test TNT à réaliser">
      <bpmn:outgoing>Flow_1hk5wyu</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_12on3ys" name="Test TNT réalisé">
      <bpmn:incoming>Flow_1moe3d2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1a5soi9" sourceRef="Activity_1q34o1e" targetRef="Gateway_0fdb65h" />
    <bpmn:exclusiveGateway id="Gateway_0fdb65h">
      <bpmn:incoming>Flow_1a5soi9</bpmn:incoming>
      <bpmn:incoming>Flow_1njcizr</bpmn:incoming>
      <bpmn:outgoing>Flow_1moe3d2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1moe3d2" sourceRef="Gateway_0fdb65h" targetRef="Event_12on3ys" />
    <bpmn:userTask id="Activity_1q34o1e" name="Réaliser le test TNT">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="VDR_FORM_RealiserTestTNT" />
        <zeebe:assignmentDefinition candidateGroups="=[groupeResponsable]" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P14D&#34;)" />
        <zeebe:ioMapping>
          <zeebe:input source="=date( substring(dateMel , 1, 10) )" target="dateMel" />
          <zeebe:input source="=siteTheorique" target="siteTheorique" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:input source="=region" target="region" />
          <zeebe:input source="=if count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE700&#34;]) &#62;= 1 and &#10;   count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE800&#34;]) = 0 &#10;then &#34;LTE700&#34; &#10;else if count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE800&#34;]) &#62;= 1 and &#10;        count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE700&#34;]) = 0 &#10;then &#34;LTE800&#34;&#10;else if count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE700&#34;]) &#62;= 1 and &#10;        count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE800&#34;]) &#62;= 1 &#10;then &#34;LTE700/LTE800&#34;&#10;else &#34;Pas de LTE700/LTE800&#34;" target="configuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cotirc</bpmn:incoming>
      <bpmn:outgoing>Flow_1a5soi9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_01iwm4g" name="s&#39;agit-il d&#39;un Bypass migration ?" default="Flow_0cotirc">
      <bpmn:incoming>Flow_0d30knk</bpmn:incoming>
      <bpmn:outgoing>Flow_0cotirc</bpmn:outgoing>
      <bpmn:outgoing>Flow_1njcizr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0cotirc" name="non" sourceRef="Gateway_01iwm4g" targetRef="Activity_1q34o1e" />
    <bpmn:sequenceFlow id="Flow_1hk5wyu" sourceRef="Event_021vwnc" targetRef="Activity_0w2h3um" />
    <bpmn:sequenceFlow id="Flow_1njcizr" name="oui" sourceRef="Gateway_01iwm4g" targetRef="Gateway_0fdb65h">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=migration = "O" and list contains(migrationActivities,"Réaliser le test TNT")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11vk517" sourceRef="Activity_0w2h3um" targetRef="Gateway_0cldvkn" />
    <bpmn:scriptTask id="Activity_0w2h3um" name="save migration variable value">
      <bpmn:extensionElements>
        <zeebe:script expression="=migration" resultVariable="old_migration" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hk5wyu</bpmn:incoming>
      <bpmn:outgoing>Flow_11vk517</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_0cldvkn" default="Flow_0e11spd">
      <bpmn:incoming>Flow_11vk517</bpmn:incoming>
      <bpmn:incoming>Flow_0q2wzec</bpmn:incoming>
      <bpmn:outgoing>Flow_0e11spd</bpmn:outgoing>
      <bpmn:outgoing>Flow_01rs74c</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0e11spd" sourceRef="Gateway_0cldvkn" targetRef="Activity_0vfgqe3" />
    <bpmn:sequenceFlow id="Flow_0d30knk" sourceRef="Activity_0vfgqe3" targetRef="Gateway_01iwm4g" />
    <bpmn:scriptTask id="Activity_0vfgqe3" name="reset migration variable value">
      <bpmn:extensionElements>
        <zeebe:script expression="=old_migration" resultVariable="migration" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0e11spd</bpmn:incoming>
      <bpmn:outgoing>Flow_0d30knk</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1tw1yug" default="Flow_0a9jm68">
      <bpmn:incoming>Flow_01rs74c</bpmn:incoming>
      <bpmn:outgoing>Flow_0sq23m6</bpmn:outgoing>
      <bpmn:outgoing>Flow_0a9jm68</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_01rs74c" sourceRef="Gateway_0cldvkn" targetRef="Gateway_1tw1yug">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=migration="O" and migration_loop &lt; number(migration_max_wait_loop)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_17ftgwv">
      <bpmn:incoming>Flow_0sq23m6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0sq23m6" sourceRef="Gateway_1tw1yug" targetRef="Event_17ftgwv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=how_migration_stop = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0a9jm68" sourceRef="Gateway_1tw1yug" targetRef="Event_1knod6y" />
    <bpmn:intermediateCatchEvent id="Event_1knod6y" name="attendre 2 secondes">
      <bpmn:incoming>Flow_0a9jm68</bpmn:incoming>
      <bpmn:outgoing>Flow_1dxsnca</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1xyhd70">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT2S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1dxsnca" sourceRef="Event_1knod6y" targetRef="Activity_1bvsast" />
    <bpmn:scriptTask id="Activity_1bvsast" name="Inc loop">
      <bpmn:extensionElements>
        <zeebe:script expression="=migration_loop + 1" resultVariable="migration_loop" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1dxsnca</bpmn:incoming>
      <bpmn:outgoing>Flow_0q2wzec</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0q2wzec" sourceRef="Activity_1bvsast" targetRef="Gateway_0cldvkn" />
    <bpmn:group id="Group_18qi9f5" categoryValueRef="CategoryValue_13zambt" />
  </bpmn:process>
