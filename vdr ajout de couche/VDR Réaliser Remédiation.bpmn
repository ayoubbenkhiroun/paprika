    <bpmn:userTask id="VDR_realiserRemediation4G" name="Réaliser Remédiation 4G">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="VDR_FORM_RealiserRemediation" />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P7D&#34;)" />
        <zeebe:assignmentDefinition candidateGroups="=[groupeResponsable]" />
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:input source="=date(substring(dateMelPrev, 1, 10))" target="dateMelPrev" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:input source="=region" target="region" />
          <zeebe:input source="=siteTheorique" target="siteTheorique" />
          <zeebe:input source="=if count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE700&#34;]) &#62;= 1 and &#10;   count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE800&#34;]) = 0 &#10;then &#34;LTE700&#34; &#10;else if count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE800&#34;]) &#62;= 1 and &#10;        count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE700&#34;]) = 0 &#10;then &#34;LTE800&#34;&#10;else if count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE700&#34;]) &#62;= 1 and &#10;        count(evolutionsFiltred[libelleTechnologie2 = &#34;LTE800&#34;]) &#62;= 1 &#10;then &#34;LTE700/LTE800&#34;&#10;else &#34;Pas de LTE700/LTE800&#34;" target="configuration" />
          <zeebe:output source="=testTnt4g700" target="testTnt4g700" />
          <zeebe:output source="=testTnt4g800" target="testTnt4g800" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_181ukc6</bpmn:incoming>
      <bpmn:outgoing>Flow_18xajqf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="VDR_realiserRemediation4G2" name="Réaliser Remédiation 4G">
