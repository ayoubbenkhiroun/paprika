      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=how_migration_stop = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0eu0iuv" sourceRef="Gateway_1w7vdcm" targetRef="Event_1c5vr18" />
    <bpmn:intermediateCatchEvent id="Event_1c5vr18" name="attendre 2 secondes">
