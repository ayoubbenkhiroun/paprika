    <bpmn:exclusiveGateway id="Gateway_1w7vdcm" default="Flow_0eu0iuv">
      <bpmn:incoming>Flow_0lxy5ry</bpmn:incoming>
      <bpmn:outgoing>Flow_0fre1yh</bpmn:outgoing>
      <bpmn:outgoing>Flow_0eu0iuv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0lxy5ry" sourceRef="Gateway_10emm5u" targetRef="Gateway_1w7vdcm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=migration="O" and migration_loop &lt; number(migration_max_wait_loop)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0c4ycml">
      <bpmn:incoming>Flow_0fre1yh</bpmn:incoming>
