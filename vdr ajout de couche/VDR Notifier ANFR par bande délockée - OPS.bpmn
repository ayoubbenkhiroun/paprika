  <bpmn:process id="VDR_NotifierANFRParBandeDelockeeOPS" name="VDR Notifier ANFR par bande délockée - OPS" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="StartEvent_1" name="Bande délockées">
      <bpmn:outgoing>Flow_1cpuy5b</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1yz19sa" name="Bande délockées par OPS ?" default="Flow_0b0t8k2">
      <bpmn:incoming>Flow_13kr619</bpmn:incoming>
      <bpmn:outgoing>Flow_0b0t8k2</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tuhhp1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1cpuy5b" sourceRef="StartEvent_1" targetRef="Activity_1ej7v7q" />
    <bpmn:sequenceFlow id="Flow_0b0t8k2" name="Oui" sourceRef="Gateway_1yz19sa" targetRef="Activity_0n0c9wm" />
    <bpmn:exclusiveGateway id="Gateway_04w023a">
      <bpmn:incoming>Flow_164vw6o</bpmn:incoming>
      <bpmn:incoming>Flow_1tuhhp1</bpmn:incoming>
      <bpmn:outgoing>Flow_1wvdi2t</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_164vw6o" sourceRef="Activity_0n0c9wm" targetRef="Gateway_04w023a" />
    <bpmn:sequenceFlow id="Flow_1tuhhp1" name="Non" sourceRef="Gateway_1yz19sa" targetRef="Gateway_04w023a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some item in bandesDelockMel satisfies item in ["LTE700", "LTE800", "NR3500"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1a2ud11" name="ANFR notifié">
      <bpmn:incoming>Flow_0kpv93l</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1wvdi2t" sourceRef="Gateway_04w023a" targetRef="Gateway_1j910uz" />
    <bpmn:userTask id="Activity_0n0c9wm" name="Notifier ANFR par bande délockée - OPS">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P7D&#34;)" />
        <zeebe:ioMapping>
          <zeebe:input source="=idANFR" target="idANFR" />
          <zeebe:input source="=siteTheorique" target="siteTheorique" />
          <zeebe:input source="=date( substring(dateMEL, 1, 10) )" target="dateMEL" />
          <zeebe:input source="=&#34;# Vérifier Accord ANFR SFR &#34; + bande" target="title" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:input source="=region" target="region" />
        </zeebe:ioMapping>
        <zeebe:formDefinition formId="VDR_FORM_NotifierANFRParBandeDelockeeOPS" />
        <zeebe:assignmentDefinition candidateGroups="=[&#34;CDD_REGLEMENTAIRE&#34;]" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0b0t8k2</bpmn:incoming>
      <bpmn:outgoing>Flow_164vw6o</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=bandesDelockMel" inputElement="bande" outputCollection="_results" outputElement="=null" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0ka3j86" name="s&#39;agit-il d&#39;un Bypass migration ?" default="Flow_13kr619">
      <bpmn:incoming>Flow_13kk17o</bpmn:incoming>
      <bpmn:outgoing>Flow_13kr619</bpmn:outgoing>
      <bpmn:outgoing>Flow_13o3ota</bpmn:outgoing>
