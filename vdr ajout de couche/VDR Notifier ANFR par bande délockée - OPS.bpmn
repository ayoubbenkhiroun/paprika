    <bpmn:sequenceFlow id="Flow_13o3ota" name="oui" sourceRef="Gateway_0ka3j86" targetRef="Gateway_1j910uz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(migration = "O" and list contains(migrationActivities, "Notifier ANFR par bande délockée - OPS"))</bpmn:conditionExpression>
