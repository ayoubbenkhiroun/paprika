      <bpmn:outgoing>Flow_1i6lcma</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1i6lcma" sourceRef="StartEvent_1" targetRef="Activity_1knn67l" />
    <bpmn:businessRuleTask id="Activity_0186mx7" name="Generation des jeux de données GCR">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="VDR_DMN_CreationGcr" resultVariable="dmnResult" />
        <zeebe:ioMapping>
          <zeebe:input source="=mappedEvolutions[1]" target="mappedEvolutions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lc8asp</bpmn:incoming>
      <bpmn:outgoing>Flow_1v9ldhu</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="Event_0gogd2x" name="GCR crée">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=bandeGCR" target="bandeGCR" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0v5hqys</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0kjl44o" sourceRef="c" targetRef="Gateway_1hgu0ba" />
    <bpmn:callActivity id="c" name="Créer GCR MEL">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="itres-gcr-chgt-creation" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=dmnResult.modeleNum" target="modeleNum" />
          <zeebe:input source="=dmnResult.responsableChangement" target="responsableChangement" />
          <zeebe:input source="=groupeSUPPORT" target="groupeSUPPORT" />
          <zeebe:input source="=split(string(now()),&#34;@&#34;)[1]" target="dateOpe" />
          <zeebe:input source="=&#34;NEW RAN&#34;" target="groupeChangement" />
          <zeebe:input source="=dmnResult.typeChangement" target="typeChangement" />
          <zeebe:input source="=&#34;Evolutif&#34;" target="contexteChangement" />
          <zeebe:input source="=&#34;CWC&#34;" target="typeWF" />
          <zeebe:input source="=&#34;MAHE|Pierrick&#34;" target="contactIntervenant" />
          <zeebe:input source="=groupeRELANCE" target="groupeRELANCE" />
          <zeebe:input source="=dmnResult.migration" target="migration" />
          <zeebe:input source="=&#34;VIDE&#34;" target="numGCRIn" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:input source="=region" target="region" />
          <zeebe:input source="=dmnResult.neName" target="equipementsGCR" />
          <zeebe:input source="=dmnResult.descriptionChangement" target="descriptionChangement" />
          <zeebe:output source="={&#10;  &#34;numGCR&#34;:numGCR,&#10;&#34;bande&#34;:dmnResult.descriptionChangement&#10;}" target="bandeGCR" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lv0clt</bpmn:incoming>
      <bpmn:outgoing>Flow_0kjl44o</bpmn:outgoing>
    </bpmn:callActivity>
