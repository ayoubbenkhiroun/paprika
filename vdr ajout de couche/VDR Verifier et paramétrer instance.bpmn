    <bpmn:scriptTask id="VDR_controlerLesChampsObligatoires" name="Controler les champs obligatoires">
      <bpmn:extensionElements>
        <zeebe:script expression="=not (&#10;  modeleSWAP = &#34;&#34; or modeleSWAP = null or&#10;  modeleAjout5GFDD = &#34;&#34; or modeleAjout5GFDD = null or&#10;  modeleAjout5GTDD = &#34;&#34; or modeleAjout5GTDD = null or&#10;  modeleAjout4G = &#34;&#34; or modeleAjout4G = null or&#10;  etatBesoin = null or etatBesoin = &#34;&#34; or&#10;  programme = null or programme = &#34;&#34; or&#10;  etatPotentiel = null or etatPotentiel = &#34;&#34; or&#10;  idOperationOsmoseList = null or idOperationOsmoseList = [] or&#10;  idBesoin = null or idBesoin =&#34;&#34; or&#10;  idProjet = null or idProjet = &#34;&#34; or&#10;  siteTheorique = null or siteTheorique = &#34;&#34; or&#10;  idPotentiel = null or idPotentiel = &#34;&#34; or&#10;  solutionDO = null or solutionDO = &#34;&#34; or&#10;  region = null or region = &#34;&#34; or&#10;  constructeur = null or constructeur = &#34;&#34; or&#10;  not(lower case(constructeur) in [&#34;huawei&#34;,&#34;ericsson&#34;,&#34;e///&#34;]) or&#10;  etatProjet = null or etatProjet = &#34;&#34; or&#10;  groupeSUPPORT = null or groupeSUPPORT = &#34;&#34; or&#10;  groupeRELANCE = null or groupeRELANCE = &#34;&#34; or&#10;   (&#10;     list contains([&#34;LP47&#34;,&#34;LP73.2&#34;] , solutionDO) and (idJv = null or idJv = &#34;&#34;)&#10;  )&#10;)" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vp0j9x</bpmn:incoming>
      <bpmn:outgoing>Flow_11kedvz</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="VDR_parametrerInstanceVdr" name="Paramétrer instance VDR">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="VDR_FORM_ParametrerInstance" />
        <zeebe:assignmentDefinition candidateGroups="=[&#34;CDD_CPL&#34;]" />
        <zeebe:ioMapping>
          <zeebe:input source="=flatten([&#10;  if modeleSWAP = null or modeleSWAP = &#34;&#34; then [&#34;modeleSWAP&#34;] else [],&#10;  if modeleAjout5GFDD = null or modeleAjout5GFDD = &#34;&#34; then [&#34;modeleAjout5GFDD&#34;] else [],&#10;  if modeleAjout5GTDD = null or modeleAjout5GTDD = &#34;&#34; then [&#34;modeleAjout5GTDD&#34;] else [],&#10;  if modeleAjout4G = null or modeleAjout4G = &#34;&#34; then [&#34;modeleAjout4G&#34;] else [],&#10;  if idProjet = null or idProjet = &#34;&#34; then [&#34;idProjet&#34;] else [],&#10;  if idBesoin = null or idBesoin = &#34;&#34; then [&#34;idBesoin&#34;] else [],&#10;  if siteTheorique = null or siteTheorique = &#34;&#34; then [&#34;siteTheorique&#34;] else [],&#10;  if idPotentiel = null or idPotentiel = &#34;&#34; then [&#34;idPotentiel&#34;] else [],&#10;  if solutionDO = null or solutionDO = &#34;&#34; then [&#34;solutionDO&#34;] else [],&#10;  if region = null or region = &#34;&#34; then [&#34;region&#34;] else [],&#10;  if idOperationOsmoseList = null or idOperationOsmoseList = [] then [&#34;idOperationOsmoseList&#34;] else [],&#10;  if etatBesoin = null or etatBesoin = &#34;&#34; then [&#34;etatBesoin&#34;] else [],  &#10;  if etatProjet = null or etatProjet = &#34;&#34; then [&#34;etatProjet&#34;] else [],&#10;  if etatPotentiel = null or etatPotentiel = &#34;&#34; then [&#34;etatPotentiel&#34;] else [],&#10;  if constructeur = null or constructeur = &#34;&#34; or  not(lower case(constructeur) in [&#34;huawei&#34;,&#34;ericsson&#34;,&#34;e///&#34;]) then [&#34;constructeur&#34;] else [],&#10;  if groupeSUPPORT = null or groupeSUPPORT = &#34;&#34; then [&#34;groupeSUPPORT&#34;] else [],&#10;  if groupeRELANCE = null or groupeRELANCE = &#34;&#34; then [&#34;groupeRELANCE&#34;] else [],&#10;if programme = null &#10;   or programme = &#34;&#34; &#10;then [&#34;programme&#34;] &#10;else [],&#10;  if (&#10;     list contains([&#34;LP47&#34;,&#34;LP73.2&#34;] , solutionDO) and (idJv = null or idJv = &#34;&#34;)&#10;  )then [&#34;idJv&#34;] else []&#10;])" target="_missingFields" />
          <zeebe:input source="=if _missingFields = null or count(_missingFields) = 0 &#10;then &#34;Aucun champ manquant.&#34;&#10;else &#34;Les champs manquants sont : &#34; + string join(_missingFields ,&#34;, &#34;)" target="_missingFieldsMessage" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:input source="=region" target="region" />
          <zeebe:input source="=LP" target="LP" />
          <zeebe:input source="=upper case(constructeur)" target="constructeur" />
          <zeebe:input source="=for x in idOperationOsmoseList return { item: x } " target="idOperationOsmoseList" />
          <zeebe:output source="=for x in idOperationOsmoseList return x.item" target="idOperationOsmoseList" />
          <zeebe:output source="=idBesoin" target="idBesoin" />
          <zeebe:output source="=etatBesoin" target="etatBesoin" />
          <zeebe:output source="=etatPotentiel" target="etatPotentiel" />
          <zeebe:output source="=idProjet" target="idProjet" />
          <zeebe:output source="=etatProjet" target="etatProjet" />
          <zeebe:output source="=idPotentiel" target="idPotentiel" />
          <zeebe:output source="=region" target="region" />
          <zeebe:output source="=idJv" target="idJv" />
          <zeebe:output source="=confCible" target="confCible" />
          <zeebe:output source="=numeroCsg" target="numeroCsg" />
          <zeebe:output source="=modeleSWAP" target="modeleSWAP" />
          <zeebe:output source="=modeleAjout4G" target="modeleAjout4G" />
          <zeebe:output source="=modeleAjout5GFDD" target="modeleAjout5GFDD" />
          <zeebe:output source="=modeleAjout5GTDD" target="modeleAjout5GTDD" />
          <zeebe:output source="=solutionDO" target="solutionDO" />
          <zeebe:output source="=programme" target="programme" />
          <zeebe:output source="=constructeur" target="constructeur" />
          <zeebe:output source="=compatibiliteCsg" target="compatibiliteCsg" />
          <zeebe:output source="=idProjetVDR" target="idProjetVDR" />
          <zeebe:output source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:output source="=idANFR" target="idANFR" />
        </zeebe:ioMapping>
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P1D&#34;)" />
