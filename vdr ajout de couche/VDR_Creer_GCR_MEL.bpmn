    <bpmn:sequenceFlow id="Flow_18iwgcj" sourceRef="Gateway_01qujdv" targetRef="Activity_1655gsr" />
    <bpmn:sequenceFlow id="Flow_0w1gbx0" sourceRef="Activity_1655gsr" targetRef="Activity_0xw2emy" />
    <bpmn:exclusiveGateway id="Gateway_0g59aev" default="Flow_0v6kz1h">
      <bpmn:incoming>Flow_1jkify6</bpmn:incoming>
      <bpmn:outgoing>Flow_19ldo7y</bpmn:outgoing>
      <bpmn:outgoing>Flow_0v6kz1h</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1jkify6" sourceRef="Gateway_01qujdv" targetRef="Gateway_0g59aev">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=migration="O" and migration_loop &lt; number(migration_max_wait_loop)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_13dbeiv">
      <bpmn:incoming>Flow_19ldo7y</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_19ldo7y" sourceRef="Gateway_0g59aev" targetRef="Event_13dbeiv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=how_migration_stop = "true"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Event_0jqrn0f" name="attendre 2 secondes">
      <bpmn:incoming>Flow_0v6kz1h</bpmn:incoming>
      <bpmn:outgoing>Flow_102kfwz</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0jfk9s1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT2S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
