<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="e787c33" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="VDR_Creer_GCR_MEL" name="VDR_Creer_GCR_MEL" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="GCR à créer reçue">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=evolutionsFiltred[list contains([&#34;4G&#34;, &#34;5G&#34;, &#34;LTE&#34;, &#34;NR&#34;], item.libelleTechnologie1)]" target="evolutionsFiltred" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1siyw2q</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1siyw2q" sourceRef="StartEvent_1" targetRef="Activity_0ele5r8" />
    <bpmn:endEvent id="Event_0zqme9w" name="GCR crées">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=bandesGCR.numGCR" target="listGCR" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10azf6m</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07z2p8n" sourceRef="Activity_0xw2emy" targetRef="Gateway_1krz2ji" />
    <bpmn:scriptTask id="Activity_0xw2emy" name="Filtrer les évolutions demandées">
      <bpmn:extensionElements>
        <zeebe:script expression="=evolutionsFiltred[contains(lower case(item.libelleType), &#34;ajout&#34;)]" resultVariable="additionEvolutions" />
        <zeebe:ioMapping>
          <zeebe:output source="=if (some item in evolutionsFiltred satisfies (not(contains(lower case(item.libelleType), &#34;ajout&#34;)) and lower case(item.operateur) = &#34;byt&#34;)) then &#10;  [&#10;    {&#10;      &#34;operateur&#34;:&#34;BYT&#34;,&#10;      &#34;libelleType&#34;: &#34;Modification d&#39;aérien&#34;,&#10;      &#34;libelleTechnologie2&#34;:&#34;SWAP&#34;,&#10;      &#34;modeleNum&#34;:modeleSWAP,&#10;      &#34;neName&#34;: swapNeName&#10;    }&#10;  ] else []" target="bytSwapEvolutions" />
          <zeebe:output source="=if (some item in evolutionsFiltred satisfies (not(contains(lower case(item.libelleType), &#34;ajout&#34;)) and lower case(item.operateur) = &#34;sfr&#34;)) then &#10;  [&#10;    {&#10;      &#34;operateur&#34;:&#34;SFR&#34;,&#10;      &#34;libelleType&#34;: &#34;Modification d&#39;aérien&#34;,&#10;      &#34;libelleTechnologie2&#34;:&#34;SWAP&#34;,&#10;      &#34;modeleNum&#34;:modeleSWAP,&#10;      &#34;neName&#34;: swapNeName&#10;    }&#10;  ] else []" target="sfrSwapEvolutions" />
          <zeebe:output source="=for item in additionEvolutions&#10;return&#10;{&#10;  operateur: item.operateur,&#10;  libelleType: item.libelleType,&#10;  libelleTechnologie2: item.libelleTechnologie2,&#10;&#10;  modeleNum:&#10;   if item.libelleTechnologie2 = &#34;NR2100&#34; then modeleAjout5GFDD&#10;   else if item.libelleTechnologie2 = &#34;NR3500&#34; then modeleAjout5GTDD&#10;   else modeleAjout4G,&#10;&#10;  neName:&#10;   distinct values(listEquipement[bandfreq = libelleTechnologie2 and codeop = operateur].nename)&#10;}&#10;" target="additionEvolutions" />
          <zeebe:output source="=if list contains([&#34;LP73.1&#34;, &#34;LP73.2&#34;], solutionDO) then union(bytSwapEvolutions, sfrSwapEvolutions) else []" target="swapEvolutions" />
          <zeebe:output source="=if count(swapEvolutions) &#62; 0 then union(additionEvolutions , swapEvolutions) else additionEvolutions" target="finalEvolutions" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0w1gbx0</bpmn:incoming>
      <bpmn:outgoing>Flow_07z2p8n</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:callActivity id="Activity_1bgcx3b" name="Créer Gcr de MEL">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="VDR_CreerGcrMelAvecDmn" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=dmnIput[item.inputId = dmnId].input" target="mappedEvolutions" />
          <zeebe:input source="=migration" target="migration" />
          <zeebe:input source="=groupeSUPPORT" target="groupeSUPPORT" />
          <zeebe:input source="=groupeRELANCE" target="groupeRELANCE" />
          <zeebe:input source="=modeleSWAP" target="modeleSWAP" />
          <zeebe:input source="=modeleAjout5GFDD" target="modeleAjout5GFDD" />
          <zeebe:input source="=modeleAjout5GTDD" target="modeleAjout5GTDD" />
          <zeebe:input source="=modeleAjout4G" target="modeleAjout4G" />
          <zeebe:input source="=migrationActivities" target="migrationActivities" />
          <zeebe:input source="=equipementGcr" target="equipementGcr" />
          <zeebe:input source="=migration_max_wait_loop" target="migration_max_wait_loop" />
          <zeebe:input source="=migration_loop" target="migration_loop" />
          <zeebe:output source="=bandeGCR" target="bandeGCR" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08w24c7</bpmn:incoming>
      <bpmn:outgoing>Flow_0lva0n4</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=dmnIds" inputElement="dmnId" outputCollection="bandesGCR" outputElement="=bandeGCR" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:scriptTask id="Activity_0jvmjbp" name="Préparer l&#39;input du DMN">
      <bpmn:extensionElements>
        <zeebe:script expression="=for item in finalEvolutions return item.libelleTechnologie2 + item.operateur + item.libelleType" resultVariable="dmnIds" />
        <zeebe:ioMapping>
          <zeebe:output source="=for item in finalEvolutions return &#10;  {&#10;    &#34;inputId&#34; : item.libelleTechnologie2 + item.operateur + item.libelleType,&#10;    &#34;input&#34; : item&#10;  }" target="dmnIput" />
          <zeebe:output source="=dmnIds" target="dmnIds" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ke649e</bpmn:incoming>
      <bpmn:outgoing>Flow_0ecnxy6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0ecnxy6" sourceRef="Activity_0jvmjbp" targetRef="Gateway_1wwz1cq" />
    <bpmn:sequenceFlow id="Flow_0lva0n4" sourceRef="Activity_1bgcx3b" targetRef="Gateway_0nu6pxv" />
    <bpmn:exclusiveGateway id="Gateway_1krz2ji" name="Y-a-t-il des GCR à créer?" default="Flow_0lkpo7g">
      <bpmn:incoming>Flow_07z2p8n</bpmn:incoming>
      <bpmn:outgoing>Flow_0ti6sj4</bpmn:outgoing>
      <bpmn:outgoing>Flow_0lkpo7g</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0ti6sj4" name="oui" sourceRef="Gateway_1krz2ji" targetRef="Gateway_12gq3ov">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(finalEvolutions) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0f86h8b">
      <bpmn:incoming>Flow_0lkpo7g</bpmn:incoming>
      <bpmn:incoming>Flow_0m3gpb7</bpmn:incoming>
      <bpmn:outgoing>Flow_10azf6m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
