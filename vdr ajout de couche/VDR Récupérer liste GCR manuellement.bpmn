  <bpmn:process id="VDR_Recuperer_Liste_GCR_Manuellement" name="VDR Récupérer liste GCR manuellement" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Vérification Comencée">
      <bpmn:outgoing>Flow_12ers42</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="Event_1sfs1s0" name="état GCR vérifiée">
      <bpmn:incoming>Flow_139lonn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="VDR_recupererLaListeDeGcr" name="Récupérer la liste de GCR">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="VDR_FORM_RecupererLaListGCR" />
        <zeebe:assignmentDefinition candidateGroups="=[&#34;CDD_GSP&#34;]" />
        <zeebe:ioMapping>
          <zeebe:input source="=if lower case(compatibiliteCsg) = &#34;oui&#34; or compatibiliteCsg = &#34;&#34;&#10;then &#34;#Récupérer liste GCR Migration&#34;&#10;else &#34;#Récupérer liste GCR IMESS&#34;" target="listGcrInputTitle" />
          <zeebe:output source="=for item in listGCRVerifMigration  return item.numGCR" target="_listGCRFiltred" />
          <zeebe:output source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:output source="=region" target="region" />
        </zeebe:ioMapping>
        <zeebe:taskSchedule dueDate="=now() + duration(&#34;P1D&#34;)" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d19ep2</bpmn:incoming>
      <bpmn:outgoing>Flow_16sp35f</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_16sp35f" sourceRef="VDR_recupererLaListeDeGcr" targetRef="Gateway_0m7ywbm" />
    <bpmn:sequenceFlow id="Flow_12ers42" sourceRef="StartEvent_1" targetRef="VDR_saveMigrationVariableValue" />
    <bpmn:sequenceFlow id="Flow_0m2dpg9" sourceRef="VDR_verifierEtatGcr" targetRef="Gateway_0234feq" />
    <bpmn:callActivity id="VDR_verifierEtatGcr" name="Vérifier état GCR">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="itres-gcr-chgt-etat" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=json(listGCRVerifMigration )" target="listGCRVerifMigration" />
          <zeebe:input source="=&#34;REA&#34;" target="etatAttenduGCR" />
          <zeebe:input source="=groupeRELANCE" target="groupeRELANCE" />
          <zeebe:input source="=groupeSUPPORT" target="groupeSUPPORT" />
          <zeebe:input source="=objectInstanceId" target="objectInstanceId" />
          <zeebe:input source="=region" target="region" />
          <zeebe:input source="=&#34;N&#34;" target="avecConf" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_025ud7i</bpmn:incoming>
      <bpmn:outgoing>Flow_0m2dpg9</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=_listGCRFiltred" inputElement="numGCR" outputCollection="listGCRCreated" outputElement="=numGCR" />
        </bpmn:extensionElements>
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">=count(listGCRCreated) &gt;= 1</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
